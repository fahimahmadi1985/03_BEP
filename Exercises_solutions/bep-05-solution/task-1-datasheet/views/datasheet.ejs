<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Datasheet</title>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px ;
            color: #333;
        }

        header {
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 3em;
        }

        h1 {
            margin: 0;
            font-size: 38px;
        }

        .box {
            text-align: center;
            margin: 20px 0;
        }

        h2 {
            color: #ff4500;
            border-bottom: 2px solid #ff4500;
            padding-bottom: 5px;
            margin-bottom: .3em;
            display: flex;
            justify-content: space-between;
        }

        h2 i {
            opacity: 0.4;
        }

        p {
            margin: 10px 0;
        }

        ul, table {
            width: 100%;
            margin: 20px 0;
            border-collapse: collapse;
        }

        ul {
            padding: 0 1em;
        }

        table th, table td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        table th {
            background-color: #ff8c00;
            color: white;
        }

        table tr:nth-child(even) {
            background-color: #f2f2f2;
        }
    </style>
</head>

<body>
    <header>
        <svg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:rgb(255,140,0);stop-opacity:1" />
                    <stop offset="100%" style="stop-color:rgb(245,69,0);stop-opacity:1" />
                </linearGradient>
            </defs>
            <rect width="100" height="100" fill="url(#grad1)" />
            <circle cx="50" cy="50" r="40" fill="white" />
            <text x="50" y="40" font-family="Arial" font-size="36" fill="url(#grad1)" text-anchor="middle"
                alignment-baseline="middle">
                AG
            </text>
            <text x="50" y="65" font-family="Arial" font-size="24" fill="url(#grad1)" text-anchor="middle"
                alignment-baseline="middle">
                GmbH
            </text>
        </svg>

        <h1>Active Global GmbH<br>Product Datasheet</h1>

    </header>
    <div class="box">
        <img src="<%= product.images[0] %>" width="300">
    </div>

    <h2>
        <%= product.family %>
        <%= product.productCode %>
        <i>
            <%= product.datasheet_version %>
        </i>
    </h2>

    <ul>
    <% product.descriptions.forEach((description)=> { %>
    <li>
        <%= description %>
    </li>
    <% }) %>
</ul>

    <h2>Features</h2>

    <ul>
        <% product.features.forEach((feature)=> { %>
        <li>
            <%= feature.name %>: <%= feature.value %>
        </li>
        <% }) %>
    </ul>

    <h2>Spare parts</h2>
    <table>
        <thead>
            <tr>
                <th>Product code</th>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
            <% product.spare_parts.forEach((part)=> { %>
            <tr>
                <td>
                    <%= part.code %>
                </td>
                <td>
                    <%= part.name %>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <h2>Certificates and compliance</h2>
    <ul>
        <li>EAN <%= product.EAN %>
        </li>
        <% product.certificates.forEach((certificate)=> { %>
        <li>
            <%= certificate.name %>
            <%= certificate.date %>
        </li>
        <% }) %>
    </ul>
</body>

</html>