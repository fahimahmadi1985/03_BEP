
<html lang="en">
  <%- include("partials/head") %>
  
  <body>
    <%- include("partials/header") %>

    <h1>Welcome to our Bullet Board app</h1>

    <% posts.forEach(x=> { %>
    <section>
      <h2><%= x.title %></h2>
      <h3><%= x.author %></h3>
      <a href="/post/<%= x.id %>">Read more >>></a>
    </section>
    <% }) %>
  </body>
</html>
