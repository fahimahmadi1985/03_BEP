<!DOCTYPE html>
<html lang="en">
  
  <body>
    <%- include("./partials/header.ejs") %>

    <h1>Welcome to our Bullet Board app</h1>

    <% posts.forEach(x=> { %>
    <div style="border: 1px solid black; padding: 10px">
      <h2><%= x.title %></h2>
      <h3><%= x.author %></h3>
      <a href="/post/<%= x.id %>">Read more >>></a>
    </div>
    <% }) %>
  </body>
</html>
